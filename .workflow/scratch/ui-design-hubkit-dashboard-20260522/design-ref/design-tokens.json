        "font_weight": "600",
        "transition": "all 200ms cubic-bezier(0.4, 0, 0.2, 1)",
        "hover": {
          "background": "oklch(0.20 0.02 264 / 0.4)",
          "color": "oklch(0.95 0.01 264)"
        }
      }
    },
    "card": {
      "glass": {
        "background": "linear-gradient(135deg, oklch(0.20 0.02 264 / 0.6) 0%, oklch(0.18 0.02 295 / 0.5) 100%)",
