    "fade_in": {
      "keyframes": "opacity 0 to 1",
      "duration": "300ms",
      "timing": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "slide_up": {
      "keyframes": "transform translateY(20px) to translateY(0), opacity 0 to 1",
      "duration": "400ms",
      "timing": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "scale_in": {
      "keyframes": "transform scale(0.95) to scale(1), opacity 0 to 1",
      "duration": "200ms",
      "timing": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "glow_pulse": {
      "keyframes": "box-shadow alternate between normal and enhanced glow",
      "duration": "2000ms",
      "timing": "ease-in-out",
      "iteration": "infinite"
    }
