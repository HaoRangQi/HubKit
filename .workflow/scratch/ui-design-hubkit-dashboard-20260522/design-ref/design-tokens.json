  "accessibility": {
    "wcag_aa_compliance": true,
    "contrast_ratios": {
      "text_primary_on_background": "14.5:1",
      "text_secondary_on_background": "7.2:1",
      "text_on_primary_button": "12.8:1",
      "text_on_glass_card": "13.1:1"
    },
    "focus_indicators": {
      "visible": true,
      "color": "oklch(0.58 0.22 264)",
      "width": "3px",
      "style": "solid"
    }
